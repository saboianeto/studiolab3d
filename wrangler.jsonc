{
  "name": "studiolab3d",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "oomm-fotos" }
  ],
  "kv_namespaces": [
    { "binding": "DADOS", "id": "116a109c576d44aabcda1f9431592bd1" }
  ],
  "d1_databases": [
    { "binding": "METRICAS", "database_name": "oomm-metricas", "database_id": "4321266f-6ac5-4b8b-8248-9f85204b7af6" }
  ],
  "observability": { "enabled": true }
}
